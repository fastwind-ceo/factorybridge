APP_ENV=production
APP_NAME=FactoryBridge API
BACKEND_CORS_ORIGINS=https://factorybridge.example.com
DATABASE_URL=postgresql+psycopg://factorybridge:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/factorybridge
REDIS_URL=redis://redis:6379/0
SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
S3_BUCKET_NAME=factorybridge-files
SIGNED_URL_EXPIRE_MINUTES=15
MAX_UPLOAD_SIZE_MB=200
